# Auf Vercel erforderlich:
# Vollständige MongoDB-Adresse inklusive Zugangsdaten; Sonderzeichen URL-kodieren.
MONGODB_URI=
# Exakter HTTPS-Ursprung des Frontends, z.B. https://stackfriends.vercel.app.
APP_ORIGIN=

# Optional: Datenbankname.
# MONGODB_DB=StackFriends-dev

# Nur lokal bei Bedarf überschreiben:
# PORT=3001
# WORLD_FILE=.data/personal-worlds.json
# npm run dev:local verwendet ausdrücklich die Dateiwelt, auch mit MONGODB_URI.
