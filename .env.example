# Ohne Zugangsdaten verwendet die lokale Entwicklung eine gemeinsame JSON-Welt.
# Auf Vercel sind MongoDB und Redis erforderlich.
MONGODB_URI=
MONGODB_DB=StackFriends-dev
REDIS_URL=
PORT=3001
# In Vercel: exakter Ursprung des separat gehosteten Frontends.
APP_ORIGIN=
# Optional: öffentliche Backend-Adresse für die direkte WebSocket-Verbindung.
API_ORIGIN=
